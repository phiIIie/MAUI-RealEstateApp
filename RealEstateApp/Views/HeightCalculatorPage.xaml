<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RealEstateApp.ViewModels"
             x:Class="RealEstateApp.Views.HeightCalculatorPage"
             Title="Height Calculator"
             x:DataType="vm:HeightCalculatorPageViewModel">

    <StackLayout Padding="20" Spacing="15">
        <Label Text="Current Pressure (hPa)" FontAttributes="Bold"/>
        <Entry Text="{Binding CurrentPressure}" Keyboard="Numeric"/>

        <Label Text="Altitude (m)" FontAttributes="Bold"/>
        <Label Text="{Binding CurrentAltitude, StringFormat='{0:N2} m'}" />

        <Label Text="Measurement Label" FontAttributes="Bold"/>
        <Entry Text="{Binding MeasurementLabel}" Placeholder="e.g., Ground Floor"/>

        <Button Text="Save Measurement"
                Command="{Binding SaveMeasurementCommand}"/>

        <Label Text="Previous Measurements:" FontAttributes="Bold" Margin="0,20,0,0"/>
        <CollectionView ItemsSource="{Binding Measurements}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding Display}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </StackLayout>
</ContentPage>
