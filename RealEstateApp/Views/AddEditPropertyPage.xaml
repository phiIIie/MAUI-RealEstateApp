<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RealEstateApp.Views.AddEditPropertyPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:RealEstateApp.Converters"
    xmlns:fa="clr-namespace:FontAwesome"
    xmlns:models="clr-namespace:RealEstateApp.Models"
    xmlns:vm="clr-namespace:RealEstateApp.ViewModels"
    Title="{Binding Title}"
    x:DataType="vm:AddEditPropertyPageViewModel">

    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding CancelSaveCommand}" Text="Cancel" />
        <ToolbarItem Command="{Binding SavePropertyCommand}" Text="Save" />
        <ToolbarItem Command="{Binding ToggleFlashlightCommand}" IconImageSource="flashlight.png" />
    </ContentPage.ToolbarItems>

    <ContentPage.Content>
        <StackLayout BackgroundColor="#E8E8E8">
            <!-- Status messages -->
            <Label
                BackgroundColor="{Binding StatusColor}"
                IsVisible="{Binding StatusMessage, Converter={converters:StringBoolConverter}}"
                Text="{Binding StatusMessage}" />

            <Label
                BackgroundColor="{Binding BatteryColor}"
                IsVisible="{Binding BatteryMessage, Converter={converters:StringBoolConverter}}"
                Text="{Binding BatteryMessage}" />

            <ScrollView VerticalOptions="FillAndExpand">
                <StackLayout Padding="15" Spacing="20">

                    <!-- Address -->
                    <Label FontSize="Medium">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span FontFamily="FA-solid" Text="{x:Static fa:IconFont.Home}" />
                                <Span Text=" " />
                                <Span Text="Address*" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Grid ColumnDefinitions="*,Auto">
                        <Entry FontSize="Medium" Text="{Binding Property.Address}" />
                        <Button
                            Text="{x:Static fa:IconFont.Home}"
                            FontFamily="FA-solid"
                            Command="{Binding GeocodeAddressCommand}"
                            IsEnabled="{Binding IsConnected}" />
                    </Grid>

                    <!-- Location -->
                    <Label FontSize="Medium">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span FontFamily="FA-solid" Text="{x:Static fa:IconFont.LocationArrow}" />
                                <Span Text=" " />
                                <Span Text="Location" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Grid ColumnDefinitions="*,*,Auto" RowDefinitions="Auto" Margin="0,5,0,0">
                        <Label Text="{Binding Latitude}" Grid.Column="0" />
                        <Label Text="{Binding Longitude}" Grid.Column="1" />
                        <Button 
                            Text="{x:Static fa:IconFont.Thumbtack}" 
                            FontFamily="FA-solid"
                            Command="{Binding GetCurrentLocationCommand}"
                            Grid.Column="2" />
                    </Grid>

                    <!-- Price -->
                    <Label FontFamily="FA-solid" FontSize="Medium">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span FontFamily="FA-solid" Text="{x:Static fa:IconFont.Tag}" />
                                <Span Text=" " />
                                <Span Text="Price*" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Entry FontSize="Medium" Text="{Binding Property.Price, Converter={converters:NullableIntConverter}}" />

                    <!-- Beds -->
                    <Label FontSize="Medium">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span FontFamily="FA-solid" Text="{x:Static fa:IconFont.Bed}" />
                                <Span Text=" " />
                                <Span Text="Bedrooms*" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Entry FontSize="Medium" Keyboard="Numeric" ReturnType="Next" Text="{Binding Property.Beds, Converter={converters:NullableIntConverter}}" />

                    <!-- Baths -->
                    <Label FontSize="Medium">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span FontFamily="FA-solid" Text="{x:Static fa:IconFont.Bath}" />
                                <Span Text=" " />
                                <Span Text="Bathroom" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Entry FontSize="Medium" Keyboard="Numeric" ReturnType="Next" Text="{Binding Property.Baths, Converter={converters:NullableIntConverter}}" />

                    <!-- Parking -->
                    <Label FontSize="Medium">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span FontFamily="FA-solid" Text="{x:Static fa:IconFont.Parking}" />
                                <Span Text=" " />
                                <Span Text="Parking" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Entry FontSize="Medium" Keyboard="Numeric" ReturnType="Next" Text="{Binding Property.Parking, Converter={converters:NullableIntConverter}}" />

                    <!-- Land size -->
                    <Label FontSize="Medium">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span FontFamily="FA-solid" Text="{x:Static fa:IconFont.Square}" />
                                <Span Text=" " />
                                <Span Text="Land Size" />
                                <Span Text=" " />
                                <Span Text="(&#x33a1;)" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Entry FontSize="Medium" Keyboard="Numeric" ReturnType="Next" Text="{Binding Property.LandSize, Converter={converters:NullableIntConverter}}" />

                    <!-- Description -->
                    <Label FontSize="Medium">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span FontFamily="FA-solid" Text="{x:Static fa:IconFont.FileAlt}" />
                                <Span Text=" " />
                                <Span Text="Description" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Editor Margin="0" AutoSize="TextChanges" FontSize="Medium" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" Keyboard="Text" Text="{Binding Property.Description}" />

                    <!-- Agent -->
                    <Label FontSize="Medium">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span FontFamily="FA-solid" Text="{x:Static fa:IconFont.UserTie}" />
                                <Span Text=" " />
                                <Span Text="Agent*" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Picker FontSize="Medium" ItemDisplayBinding="{Binding Name}" ItemsSource="{Binding Agents}" SelectedItem="{Binding SelectedAgent}" />

                </StackLayout>
            </ScrollView>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
