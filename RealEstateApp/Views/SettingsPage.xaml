<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RealEstateApp.ViewModels"
             x:Class="RealEstateApp.Views.SettingsPage"
             Title="Settings">

    <ContentPage.BindingContext>
        <vm:SettingsPageViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="20" Spacing="25">
        <Label Text="Volume" FontAttributes="Bold" />
        <Slider Minimum="0" Maximum="1"
                Value="{Binding Volume, Mode=TwoWay}" />

        <Label Text="Pitch" FontAttributes="Bold" />
        <Slider Minimum="0.1" Maximum="2"
                Value="{Binding Pitch, Mode=TwoWay}" />

        <Button Text="Reset to Default"
                Command="{Binding ResetCommand}" />
    </VerticalStackLayout>
</ContentPage>
