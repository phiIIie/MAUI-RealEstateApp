<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:fa="clr-namespace:FontAwesome"
             xmlns:vm="clr-namespace:RealEstateApp.ViewModels"
             x:Class="RealEstateApp.Views.CompassPage"
             x:DataType="vm:CompassViewModel"
             Title="Compass">

    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*"
          Padding="20">

        <!-- Aspect Label -->
        <Label FontSize="Large"
               FontFamily="FA-solid"
               HorizontalOptions="Center"
               VerticalOptions="Center">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="{x:Static fa:IconFont.ArrowUp}" FontFamily="FA-solid"/>
                    <Span Text=" " />
                    <Span Text="{Binding CurrentAspect}" />
                    <Span Text=" Aspect" />
                    <Span Text=" " />
                    <Span Text="{x:Static fa:IconFont.ArrowUp}" FontFamily="FA-solid"/>
                </FormattedString>
            </Label.FormattedText>
        </Label>

        <!-- Compass Image -->
        <Image Source="compass.png"
               Rotation="{Binding RotationAngle}"
               Grid.Row="1"
               Grid.Column="0"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               WidthRequest="250"
               HeightRequest="250" />

        <!-- Heading -->
        <Label Text="{Binding CurrentHeading, StringFormat='Heading: {0:N2}°'}"
               FontSize="Medium"
               Margin="0,20"
               Grid.Row="2"
               Grid.Column="0"
               HorizontalOptions="Center" />
    </Grid>
</ContentPage>
